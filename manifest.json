{
  "manifest_version": 3,
  "name": "SigGuard // Anti-Drainer",
  "version": "1.0.0",
  "description": "Intercepts blind signing and malicious eth_sign/eth_sendTransaction requests.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}